{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep TypeScript 5 while openapi-typescript requires its compiler API and peer range.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0"
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "ci"]
    },
    {
      "description": "Keep the views package's peer ranges at the versions web/package.json pins.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  }
}

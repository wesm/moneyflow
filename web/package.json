{
  "name": "moneyflow-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "generate": "bun run scripts/generate-api.ts",
    "generate:check": "bun run scripts/generate-api.ts --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:usage": "kit-ui-check src",
    "check": "bun run generate:check && bun run typecheck && bun run lint && bun run format:check && bun run check:usage",
    "budgets": "bun run scripts/check-budgets.ts dist budgets.json",
    "audit": "bun audit --audit-level high",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "dev": "vite"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#dc7a4184843343cb1fa639ea6e77b68d13e755af",
    "@lucide/svelte": "1.55.0",
    "openapi-fetch": "0.17.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
